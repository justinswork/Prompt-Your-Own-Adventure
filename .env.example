# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — never commit real keys.

# Required: powers the scenario generator and Rule Enforcer.
OPENAI_API_KEY=sk-your-openai-key-here

# Required for the default Claude narrator. Optional if you only
# plan to /swap to an OpenAI narrator at runtime.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
